# Public URL used for canonical links, sitemap and structured data
# NEXT_PUBLIC_SITE_URL=https://www.beetrix360.com

# DynamoDB Database Configuration
# CONTENT_SOURCE=dynamodb
# DYNAMODB_CONTENT_TABLE=Beetrix_Content
# DDB_REGION=us-east-1

# Admin Authentication Secret (32+ chars random string)
# AUTH_SECRET=7c8f9b2d4e1a6c8e3f0b5d9a2c4e7f1b9a8c3d5e2f4a6b8c1d9e0f2a4b6c8e1

# Amazon S3 & CloudFront CDN Media Storage
# S3_MEDIA_BUCKET=beetrix360-media-storage
# S3_REGION=us-east-1
# NEXT_PUBLIC_CDN_URL=https://your-cloudfront-id.cloudfront.net

# Optional: IAM Credentials if not using IAM Service Role
# APP_AWS_ACCESS_KEY_ID=
# APP_AWS_SECRET_ACCESS_KEY=
